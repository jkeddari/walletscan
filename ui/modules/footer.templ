package modules

import "time"

templ Footer() {
	<footer class="border-t border-border/60">
		<div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
			<div>
				© { time.Now().Year() } WalletScan
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<span>Multi-chain wallet lookup</span>
				<a href="mailto:contact@walletscan.fi" class="transition-colors hover:text-foreground">
					contact@walletscan.fi
				</a>
			</div>
		</div>
	</footer>
}
