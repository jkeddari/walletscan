package modules

templ Header() {
	<header class="flex items-center justify-between px-4 py-2 border-b border-accent">
		<a href="/" class="flex items-center">
			<h1 class="font-orbitron text-2xl bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent font-bold tracking-wider">
				WS
			</h1>
		</a>
		<div class="flex items-center gap-4">
			<a href="/" class="text-sm text-muted-foreground hover:text-foreground">
				Home
			</a>
			<a href="/about" class="text-sm text-muted-foreground hover:text-foreground">
				About
			</a>
			@ThemeSwitcher()
		</div>
	</header>
}
