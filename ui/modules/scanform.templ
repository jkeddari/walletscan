package modules

import (
	"github.com/jkeddari/walletscan/ui/components/input"
	"github.com/jkeddari/walletscan/ui/components/button"
	"github.com/jkeddari/walletscan/ui/components/spinner"
	"github.com/jkeddari/walletscan/ui/components/form"
)

templ ScanForm(address string, showError bool) {
	<form
		hx-post="/scan-address"
		hx-trigger="submit"
		hx-swap="outerHTML"
		hx-target="this"
		hx-indicator="#spinner"
		hx-disabled-elt="find button"
		class="w-full"
	>
		@form.Item(form.ItemProps{
			Class: "rounded-[1.75rem] border border-border/70 bg-background/90 p-2 shadow-[0_24px_80px_-40px_rgba(15,23,42,0.45)] backdrop-blur",
		}) {
			<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
				<div class="min-w-0 flex-1">
					@form.Description(form.DescriptionProps{
						Class: "px-4 pt-2 text-left text-[0.7rem] font-medium uppercase tracking-[0.28em]",
					}) {
						Wallet address
					}
					@input.Input(input.Props{
						Class:       "h-14 border-0 bg-transparent px-4 text-base shadow-none focus-visible:ring-0 focus-visible:ring-offset-0",
						Type:        input.TypeText,
						Name:        "address",
						Placeholder: "Paste a Bitcoin, Ethereum, Solana or Tron address",
						Value:       address,
						Required:    true,
						HasError:    showError,
					})
				</div>
				@button.Button(button.Props{
					Type:  button.TypeSubmit,
					Class: "h-14 rounded-2xl px-5 text-sm font-semibold sm:min-w-[140px]",
				}) {
					<span id="spinner" class="htmx-indicator hidden [&.htmx-request]:inline-flex">
						@spinner.Spinner(spinner.Props{
							Size:  spinner.SizeSm,
							Color: "text-primary-foreground",
						})
					</span>
					Scan wallet
				}
			</div>
			if showError {
				@form.Message(form.MessageProps{
					Class:   "px-4 pb-2",
					Variant: form.MessageVariantError,
				}) {
					Invalid wallet address. Please check it and try again.
				}
			}
		}
	</form>
}
