package pages

import (
	"github.com/jkeddari/walletscan/ui/components/card"
	"github.com/jkeddari/walletscan/ui/layouts"
)

var networksStyleList = map[string]string{
	"bitcoin":   "border border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-200",
	"solana":    "border border-violet-500/20 bg-violet-500/10 text-violet-700 dark:text-violet-200",
	"ethereum":  "border border-sky-500/20 bg-sky-500/10 text-sky-700 dark:text-sky-200",
	"bsc":       "border border-yellow-500/20 bg-yellow-500/10 text-yellow-700 dark:text-yellow-200",
	"polygon":   "border border-fuchsia-500/20 bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-200",
	"base":      "border border-indigo-500/20 bg-indigo-500/10 text-indigo-700 dark:text-indigo-200",
	"avalanche": "border border-orange-500/20 bg-orange-500/10 text-orange-700 dark:text-orange-200",
	"arbitrum":  "border border-cyan-500/20 bg-cyan-500/10 text-cyan-700 dark:text-cyan-200",
	"tron":      "border border-rose-500/20 bg-rose-500/10 text-rose-700 dark:text-rose-200",
}

func getNetworkStyle(network string) string {
	if style, ok := networksStyleList[network]; ok {
		return style
	}

	return "border border-border bg-muted text-foreground"
}

templ About() {
	@layouts.BaseLayout() {
		<main class="flex-1">
			<section class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 pb-16 pt-10 sm:px-6 lg:px-8">
				<div class="mx-auto max-w-3xl text-center">
					<div class="inline-flex items-center rounded-full border border-border/70 bg-background/80 px-4 py-2 text-xs font-medium uppercase tracking-[0.28em] text-muted-foreground shadow-sm">
						About the product
					</div>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">WalletScan keeps wallet lookup simple.</h1>
					<p class="mt-4 text-base text-muted-foreground sm:text-lg">
						The product is built for one job: paste a wallet address, get a readable multi-chain snapshot, and move on. No portfolio setup, no account wall, no noisy dashboard.
					</p>
				</div>
				<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
					@card.Card(card.Props{
						Class: "border-border/70 bg-card/80 shadow-sm",
					}) {
						@card.Header() {
							@card.Title() {
								What WalletScan does
							}
							@card.Description() {
								A fast way to inspect an address across supported chains.
							}
						}
						@card.Content(card.ContentProps{
							Class: "space-y-4 pt-4 text-sm text-muted-foreground sm:text-base",
						}) {
							<p>
								WalletScan is designed for crypto users who want a clean answer, not a complex dashboard.
							</p>
							<ul class="list-disc space-y-2 pl-5">
								<li>Detect a supported wallet type automatically</li>
								<li>Fetch balances across multiple networks</li>
								<li>Enrich holdings with current token prices</li>
								<li>Show the portfolio in a compact, readable table</li>
							</ul>
						}
					}
					@card.Card(card.Props{
						Class: "border-border/70 bg-card/80 shadow-sm",
					}) {
						@card.Header() {
							@card.Title() {
								Product principles
							}
							@card.Description() {
								Minimal surface, useful output, no distraction.
							}
						}
						@card.Content(card.ContentProps{
							Class: "space-y-3 pt-4 text-sm text-muted-foreground sm:text-base",
						}) {
							<p>One search input is the product. Everything else supports that core flow.</p>
							<p>That is why the interface stays lightweight, mobile-friendly, and centered on the scan result rather than on account management.</p>
						}
					}
				</div>
				@card.Card(card.Props{
					Class: "border-border/70 bg-card/80 shadow-sm",
				}) {
					@card.Header() {
						@card.Title() {
							Supported networks
						}
						@card.Description() {
							Major chains currently handled by the scanner.
						}
					}
					@card.Content(card.ContentProps{
						Class: "flex flex-wrap gap-3 pt-4",
					}) {
						for network, style := range networksStyleList {
							<div class={ "rounded-full px-3 py-1.5 text-sm font-medium " + style }>{ network }</div>
						}
					}
				}
			</section>
		</main>
	}
}
