package layouts

import (
	"github.com/jkeddari/walletscan/ui/components/input"
	"github.com/jkeddari/walletscan/ui/modules"
)

templ ThemeSwitcherScript() {
	{{ handle := templ.NewOnceHandle() }}
	@handle.Once() {
		<script nonce={ templ.GetNonce(ctx) }>
			// Initial theme setup
			document.documentElement.classList.toggle('dark', localStorage.getItem('appTheme') === 'dark');

			document.addEventListener('alpine:init', () => {
				Alpine.data('themeHandler', () => ({
					isDark: localStorage.getItem('appTheme') === 'dark',
					toggleTheme() {
						this.isDark = !this.isDark;
						localStorage.setItem('appTheme', this.isDark ? 'dark' : 'light');
						document.documentElement.classList.toggle('dark', this.isDark);
					}
				}))
			})
		</script>
	}
}

templ BaseLayout() {
	<!DOCTYPE html>
	<html lang="en" class="h-full scroll-smooth dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="WalletScan lets you scan a crypto wallet address in seconds and view balances across Bitcoin, Ethereum, Solana, Tron, and more."/>
			<meta name="theme-color" content="#0f172a"/>
			<title>WalletScan | Simple multi-chain wallet scanner</title>
			<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer','GTM-MR3CWDQ7');
			</script>
			@input.Script()
			@ThemeSwitcherScript()
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<link href="/assets/favicon.ico" rel="icon" type="image/x-icon"/>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
			<script async src="https://www.googletagmanager.com/gtag/js?id=G-DHT46C8XLJ"></script>
			<script>
			  window.dataLayer = window.dataLayer || [];
			  function gtag(){dataLayer.push(arguments);}
			  gtag('js', new Date());

			  gtag('config', 'G-DHT46C8XLJ');
			</script>
		</head>
		<body class="min-h-screen bg-background text-foreground antialiased selection:bg-primary selection:text-primary-foreground" x-data="themeHandler">
			<noscript>
				<iframe
					src="https://www.googletagmanager.com/ns.html?id=GTM-MR3CWDQ7"
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				></iframe>
			</noscript>
			<div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.16),_transparent_60%)]"></div>
			<div class="pointer-events-none fixed inset-0 -z-20 bg-[linear-gradient(to_bottom,_rgba(255,255,255,0.98),_rgba(248,250,252,1))] dark:bg-[linear-gradient(to_bottom,_rgba(2,6,23,0.98),_rgba(3,7,18,1))]"></div>
			<div class="flex min-h-screen flex-col">
				@modules.Header()
				{ children... }
				@modules.Footer()
			</div>
		</body>
	</html>
}
